{
  "name": "qedge",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check",
    "fmt": "oxfmt",
    "dev:gw": "bun --watch src/gateway/index.ts",
    "build:gw": "bun build src/gateway/index.ts --bytecode --target bun --production --outdir=dist",
    "dev:mqtt": "bun --watch src/mqtt/index.ts",
    "dev:mqtt:http": "bun --watch src/mqtt/http.ts",
    "build:mqtt": "bun build src/mqtt/index.ts --bytecode --target bun --production --outdir=dist"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "mqtt": "^5.16.1"
  }
}